# Next.js frontend env vars
# Copy this file to .env.local and adjust values.

# URL of the backend API (NestJS).
# Dev:  http://localhost:3001/api (or :3000 if backend is on default port)
# Prod: https://api.animesice.app/api
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# URL pública do site (canonical, sitemap, robots, OG images).
# IMPORTANTE: o apex animesice.app redireciona (308) para www.animesice.app.
# Se a canonical apontar para um domínio que redireciona, o Google trata as
# duas versões como duplicatas e não usa sua canonical. Em produção SEMPRE
# use o www: https://www.animesice.app (já é o fallback do código).
# NEXT_PUBLIC_SITE_URL=https://www.animesice.app

# Origem usada exclusivamente para chunks/assets em produção. As páginas
# navegáveis desse host são redirecionadas para NEXT_PUBLIC_SITE_URL.
# NEXT_PUBLIC_ASSET_URL=https://animesice.vercel.app

# Destino canônico dos títulos adultos migrados. Quando uma URL deixa de
# existir na API principal, o frontend valida a página equivalente aqui antes
# de emitir um redirect permanente (sem lista manual de slugs).
# NEXT_PUBLIC_HENTAIS_SITE_URL=https://www.hentaisice.com

# Google AdSense publisher client ID.
# Coloque o ca-pub-XXXXXXXXXXXXXXXX exibido no painel do AdSense.
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-2885915887212760

# Turnstile (CAPTCHA) sitekey — get from https://dash.cloudflare.com/turnstile
NEXT_PUBLIC_TURNSTILE_SITEKEY=0x4AAAAAAEJ2yW0QjDiK6Rmj

# Monetag (al5sm.com) — rede de push/pop ads.
# Ativo por padrão. Defina como 1 para NÃO carregar o Monetag (dev/build atual
# em que você não quer rodar ads e evitar o overhead do loader).
NEXT_PUBLIC_DISABLE_MONETAG=0
